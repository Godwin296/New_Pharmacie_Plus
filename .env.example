# .env de la RACINE du projet -- distinct de pharmacie-backend/.env.
#
# Docker Compose lit automatiquement un fichier ".env" situé à CÔTÉ de docker-compose.yml
# pour interpoler les variables ${...} utilisées DANS docker-compose.yml lui-même (le
# service "db" a besoin de DB_NAME/DB_USER/DB_PASSWORD avant même que le conteneur
# backend ne démarre et ne lise son propre .env). Ce fichier-ci sert UNIQUEMENT à ça.
#
# -> Copie-le en ".env" à la racine, remplis les valeurs, puis fais pareil pour
#    pharmacie-backend/.env (à partir de pharmacie-backend/.env.example) : les DEUX
#    fichiers sont nécessaires, pour deux raisons différentes. Les valeurs de
#    DB_NAME/DB_USER/DB_PASSWORD doivent être IDENTIQUES dans les deux fichiers.

DB_NAME=pharmacie_saas
DB_USER=postgres
DB_PASSWORD=remplace-moi

# Optionnel -- voir le commentaire dans pharmacie-frontend/Dockerfile. Inutile en usage
# standard (multi-tenant par sous-domaine localhost), à ne remplir que pour un
# déploiement avec une URL backend fixe.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=
