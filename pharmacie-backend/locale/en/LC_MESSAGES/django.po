#: core/api.py:159
msgid "Le format de l'image n'est pas autorisé (JPG, PNG, WEBP uniquement)."
msgstr "Image format not allowed (JPG, PNG, WEBP only)."

#: core/api.py:161
msgid "L'image ne doit pas dépasser 2 Mo."
msgstr "The image must not exceed 2 MB."

#: core/api.py:206
msgid "Configuration de paiement non disponible pour cette pharmacie."
msgstr "Payment configuration not available for this pharmacy."

#: core/api.py:248
msgid "email, password et nom sont obligatoires"
msgstr "email, password and name are required"

#: core/api.py:250
msgid "Le mot de passe doit contenir au moins 8 caractères"
msgstr "Password must contain at least 8 characters"

#: core/api.py:252
msgid "Un compte existe déjà avec cet email"
msgstr "An account already exists with this email"

#: core/api.py:277 core/api.py:280 core/api.py:422
msgid "Identifiants invalides"
msgstr "Invalid credentials"

#: core/api.py:334
msgid "Langue non supportée. Valeurs acceptées : fr, en, ou vide (Système)."
msgstr "Unsupported language. Accepted values: fr, en, or empty (System)."

#: core/api.py:373
msgid "Mot de passe actuel incorrect."
msgstr "Current password is incorrect."

#: core/api.py:375
msgid "Le nouveau mot de passe doit contenir au moins 8 caractères."
msgstr "The new password must contain at least 8 characters."

#: core/api.py:395
msgid "Rôle non autorisé pour ce compte"
msgstr "Role not authorized for this account"

#: core/api.py:596 core/api.py:663
msgid "Réservé aux administrateurs"
msgstr "Reserved for administrators"

#: core/api.py:629
msgid "Code vide"
msgstr "Empty code"

#: core/api.py:634
msgid "Code non reconnu"
msgstr "Code not recognized"

#: core/api.py:667
msgid "code_barre requis"
msgstr "code_barre is required"

#: core/api.py:680
msgid "Ce code-barres est déjà rattaché à un autre produit."
msgstr "This barcode is already linked to another product."

#: core/api.py:691
msgid ""
"Ce code-barres vient d'être rattaché à un autre produit entre-temps. "
"Rescannez pour vérifier."
msgstr ""
"This barcode was just linked to another product in the meantime. Scan again "
"to check."

#: core/api.py:803
msgid "Paramètre 'since' invalide, attendu au format ISO8601"
msgstr "Invalid 'since' parameter, expected ISO8601 format"

#: core/api.py:859
msgid "Le personnel ne peut pas avoir de panier client"
msgstr "Staff cannot have a client cart"

#: core/api.py:902 core/api.py:956
msgid "Quantité invalide"
msgstr "Invalid quantity"

#: core/api.py:907 core/api.py:959
msgid "Stock insuffisant"
msgstr "Insufficient stock"

#: core/api.py:936
msgid "Réservé aux comptes clients"
msgstr "Reserved for client accounts"

#: core/api.py:983 core/api.py:1141
msgid "Action réservée aux clients"
msgstr "Action reserved for clients"

#: core/api.py:989
msgid ""
"Cette commande ne peut pas être soumise au paiement dans son état actuel."
msgstr "This order cannot be submitted for payment in its current state."

#: core/api.py:993
msgid ""
"Une ordonnance valide est requise avant de pouvoir payer cette commande."
msgstr "A valid prescription is required before this order can be paid."

#: core/api.py:999
msgid "Moyen de paiement invalide."
msgstr "Invalid payment method."

#: core/api.py:1001
msgid "Merci de renseigner la référence de transaction reçue par SMS."
msgstr "Please enter the transaction reference received by SMS."

#: core/api.py:1033 core/api.py:1066 core/api.py:1082 core/api.py:1108
msgid "Action réservée au personnel de la pharmacie"
msgstr "Action reserved for pharmacy staff"

#: core/api.py:1039
msgid "Cette commande n'est pas en attente de vérification de paiement."
msgstr "This order is not awaiting payment verification."

#: core/api.py:1210
msgid "Action non autorisée pour un client"
msgstr "Action not authorized for a client"

#: core/api.py:1234
msgid "Cette ordonnance a déjà été traitée par un autre agent."
msgstr "This prescription has already been processed by another agent."

#: core/api.py:1280
msgid "Action invalide"
msgstr "Invalid action"

#: core/api.py:1282
msgid "Requête invalide"
msgstr "Invalid request"

#: core/api.py:1291
msgid "Accès refusé. Droits d'administration requis."
msgstr "Access denied. Administrator rights required."

#: core/api.py:1401
msgid "La quantité doit être un entier positif"
msgstr "Quantity must be a positive integer"

#: core/api.py:1436
msgid "La quantité doit être un entier strictement positif"
msgstr "Quantity must be a strictly positive integer"

#: core/api.py:1446
msgid "Date de péremption invalide (format attendu : AAAA-MM-JJ)"
msgstr "Invalid expiration date (expected format: YYYY-MM-DD)"

#: core/api.py:1474 core/api.py:1488
msgid "Accès interdit : Droits administrateur requis"
msgstr "Access forbidden: Administrator rights required"

#: core/api.py:1565
msgid "produit_ids doit être une liste non vide d'identifiants produit."
msgstr "produit_ids must be a non-empty list of product identifiers."

#: core/api.py:1570
msgid "produit_ids doit contenir uniquement des entiers."
msgstr "produit_ids must contain only integers."

#: core/api.py:1599 core/api.py:1638 core/api.py:1833 core/api.py:1866
msgid "Accès réservé à l'administrateur."
msgstr "Access reserved for the administrator."

#: core/api.py:1605 core/api.py:1646
msgid "lookback_jours et lead_time_jours doivent être des entiers"
msgstr "lookback_jours and lead_time_jours must be integers"

#: core/api.py:1608 core/api.py:1649
msgid "Paramètres hors limites"
msgstr "Parameters out of range"

#: core/api.py:1661
msgid "Action réservée à l'administrateur"
msgstr "Action reserved for the administrator"

#: core/api.py:1684
msgid "Fichier manquant"
msgstr "Missing file"

#: core/api.py:1692
msgid "Accès réservé au guichet"
msgstr "Access reserved for counter staff"

#: core/api.py:1700
msgid "Le panier est vide"
msgstr "The cart is empty"

#: core/api.py:1716
#, python-format
msgid ""
"Ordonnance requise pour : %(noms)s. Merci de confirmer l'avoir vérifiée "
"avant de valider la vente."
msgstr ""
"Prescription required for: %(noms)s. Please confirm you have checked it "
"before completing the sale."

#: core/api.py:1787
#, python-format
msgid "Erreur technique : %(detail)s"
msgstr "Technical error: %(detail)s"

#: core/api.py:1809
msgid "Réservé au personnel de la pharmacie"
msgstr "Reserved for pharmacy staff"

#: core/api.py:1871
msgid ""
"Ce client n'a pas d'adresse email enregistrée -- impossible de lui envoyer "
"un nouveau mot de passe automatiquement."
msgstr ""
"This client has no registered email address -- unable to send a new password"
" automatically."

#: core/api.py:1886
msgid ""
"Le nouveau mot de passe n'a PAS pu être envoyé par email (problème de "
"configuration Brevo/SMTP côté serveur) -- le mot de passe du client n'a donc"
" PAS été modifié, pour éviter de le bloquer sans recours."
msgstr ""
"The new password could NOT be sent by email (Brevo/SMTP server-side "
"configuration issue) -- the client's password was therefore NOT changed, to "
"avoid locking them out with no recourse."

#: core/authentication.py:44
msgid "Ce jeton client ne peut pas être utilisé sur les routes du personnel."
msgstr "This client token cannot be used on staff routes."

#: core/authentication.py:60
msgid "Ce jeton n'est pas un jeton client valide."
msgstr "This token is not a valid client token."

#: core/authentication.py:66 core/authentication.py:99
msgid "Le jeton ne contient pas d'identifiant utilisateur."
msgstr "The token does not contain a user identifier."

#: core/authentication.py:71 core/authentication.py:104
msgid "Compte client introuvable ou désactivé."
msgstr "Client account not found or deactivated."

#: core/emails.py:84
#, python-format
msgid "Merci pour votre achat chez %(pharmacie)s."
msgstr "Thank you for your purchase at %(pharmacie)s."

#: core/emails.py:86
#, python-format
msgid ""
"Votre commande %(reference)s a bien été payée et est prête à être récupérée "
"au guichet de %(pharmacie)s."
msgstr ""
"Your order %(reference)s has been paid and is ready for pickup at the "
"%(pharmacie)s counter."

#: core/emails.py:93
#, python-format
msgid "%(pharmacie)s — Reçu de votre achat"
msgstr "%(pharmacie)s — Receipt for your purchase"

#: core/emails.py:95
#, python-format
msgid "%(pharmacie)s — Commande %(reference)s prête au retrait"
msgstr "%(pharmacie)s — Order %(reference)s ready for pickup"

#: core/emails.py:100 core/emails.py:144 core/emails.py:191 core/emails.py:242
#, python-format
msgid "Bonjour %(nom)s,"
msgstr "Hello %(nom)s,"

#: core/emails.py:102
msgid "Détail de la commande :"
msgstr "Order details:"

#: core/emails.py:103
#, python-format
msgid "Total : %(total)s %(devise)s"
msgstr "Total: %(total)s %(devise)s"

#: core/emails.py:142
#, python-format
msgid "%(pharmacie)s — Votre nouveau mot de passe"
msgstr "%(pharmacie)s — Your new password"

#: core/emails.py:145
#, python-format
msgid "Votre mot de passe a été réinitialisé par l'équipe de %(pharmacie)s."
msgstr "Your password has been reset by the %(pharmacie)s team."

#: core/emails.py:148
msgid "Voici votre nouveau mot de passe temporaire :"
msgstr "Here is your new temporary password:"

#: core/emails.py:150
msgid ""
"Merci de vous connecter avec ce mot de passe, puis de le modifier dès que "
"possible depuis votre profil."
msgstr ""
"Please log in with this password, then change it as soon as possible from "
"your profile."

#: core/emails.py:152
#, python-format
msgid ""
"Si vous n'êtes pas à l'origine de cette demande, contactez immédiatement "
"%(pharmacie)s."
msgstr "If you did not make this request, contact %(pharmacie)s immediately."

#: core/emails.py:183
#, python-format
msgid "Bienvenue chez %(pharmacie)s 🎉"
msgstr "Welcome to %(pharmacie)s 🎉"

#: core/emails.py:188
#, python-format
msgid " (identifiant : %(id)s)"
msgstr " (ID: %(id)s)"

#: core/emails.py:192
#, python-format
msgid "Ton compte %(pharmacie)s a bien été créé%(ligne_identifiant)s."
msgstr "Your %(pharmacie)s account has been created%(ligne_identifiant)s."

#: core/emails.py:195
msgid ""
"Tu peux dès maintenant parcourir le catalogue, passer commande en ligne et "
"payer par Orange Money ou MTN MoMo, pour venir récupérer directement au "
"guichet."
msgstr ""
"You can now browse the catalog, place an order online and pay by Orange "
"Money or MTN MoMo, then pick it up directly at the counter."

#: core/emails.py:198
msgid "À très vite !"
msgstr "See you soon!"

#: core/emails.py:237
#, python-format
msgid "%(pharmacie)s — Ordonnance refusée pour la commande %(reference)s"
msgstr "%(pharmacie)s — Prescription rejected for order %(reference)s"

#: core/emails.py:240
msgid "Document invalide"
msgstr "Invalid document"

#: core/emails.py:243
#, python-format
msgid ""
"L'ordonnance envoyée pour ta commande %(reference)s n'a malheureusement pas "
"pu être validée par %(pharmacie)s."
msgstr ""
"The prescription sent for your order %(reference)s could unfortunately not "
"be approved by %(pharmacie)s."

#: core/emails.py:247
#, python-format
msgid "Motif : %(motif)s"
msgstr "Reason: %(motif)s"

#: core/emails.py:248
msgid ""
"Tu peux te reconnecter à l'application pour envoyer un nouveau document et "
"relancer ta commande."
msgstr ""
"You can log back into the app to send a new document and resume your order."

#: core/emails.py:250
#, python-format
msgid "Si tu as des questions, contacte directement %(pharmacie)s."
msgstr "If you have any questions, contact %(pharmacie)s directly."
